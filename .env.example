# Supabase — Project Settings → API
# Use the "Project URL" (NOT the REST URL — no /rest/v1 at the end)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables cross-request caching for analytics/dashboard/search
# Project Settings → API → service_role (keep secret, server-only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (used for email confirmation redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
